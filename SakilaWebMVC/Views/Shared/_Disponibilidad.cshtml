@model Pelicula
@* Partial: etiqueta de disponibilidad segun copias libres *@
@if (!Model.Activo)
{
    <span class="badge bg-secondary">Dada de baja</span>
}
else if (Model.Copias == 0)
{
    <span class="badge bg-warning text-dark">Sin copias</span>
}
else if (Model.Disponibles > 0)
{
    <span class="badge bg-success">Disponible (@Model.Disponibles de @Model.Copias)</span>
}
else
{
    <span class="badge bg-danger">No disponible (0 de @Model.Copias)</span>
}
