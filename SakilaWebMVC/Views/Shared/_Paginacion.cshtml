@model PeliculasIndexViewModel
@* Partial: paginacion con ventana de paginas, conservando los filtros *@
@{
    int inicio = Math.Max(1, Model.Pagina - 2);
    int fin = Math.Min(Model.TotalPaginas, Model.Pagina + 2);
}
@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Paginación del catálogo">
        <ul class="pagination pagination-sm justify-content-center flex-wrap">
            <li class="page-item @(Model.Pagina == 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pagina="@(Model.Pagina - 1)" asp-route-busqueda="@Model.Busqueda"
                   asp-route-rating="@Model.Rating" asp-route-verInactivas="@Model.VerInactivas">Anterior</a>
            </li>

            @if (inicio > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index"
                       asp-route-pagina="1" asp-route-busqueda="@Model.Busqueda"
                       asp-route-rating="@Model.Rating" asp-route-verInactivas="@Model.VerInactivas">1</a>
                </li>
                @if (inicio > 2)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }

            @for (int i = inicio; i <= fin; i++)
            {
                <li class="page-item @(i == Model.Pagina ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-pagina="@i" asp-route-busqueda="@Model.Busqueda"
                       asp-route-rating="@Model.Rating" asp-route-verInactivas="@Model.VerInactivas">@i</a>
                </li>
            }

            @if (fin < Model.TotalPaginas)
            {
                @if (fin < Model.TotalPaginas - 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item">
                    <a class="page-link" asp-action="Index"
                       asp-route-pagina="@Model.TotalPaginas" asp-route-busqueda="@Model.Busqueda"
                       asp-route-rating="@Model.Rating" asp-route-verInactivas="@Model.VerInactivas">@Model.TotalPaginas</a>
                </li>
            }

            <li class="page-item @(Model.Pagina == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pagina="@(Model.Pagina + 1)" asp-route-busqueda="@Model.Busqueda"
                   asp-route-rating="@Model.Rating" asp-route-verInactivas="@Model.VerInactivas">Siguiente</a>
            </li>
        </ul>
    </nav>
}
