@model List<Alquiler>
@{
    ViewData["Title"] = "Mis alquileres";
}

<h1 class="h3 mb-3">Mis alquileres</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">Aún no has alquilado películas.
        <a asp-controller="Peliculas" asp-action="Index">Ir al catálogo</a></div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>#</th><th>Película</th><th>Alquilada</th><th>Devuelta</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (Alquiler a in Model)
        {
            <tr>
                <td>@a.RentalId</td>
                <td><a asp-controller="Peliculas" asp-action="Detalle" asp-route-id="@a.FilmId">@a.Title</a></td>
                <td>@a.RentalDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@(a.ReturnDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                <td>
                    <span class="badge @(a.Activo ? "bg-warning text-dark" : "bg-success")">@a.Estado</span>
                </td>
                <td class="text-end">
                    @if (a.Activo)
                    {
                        <form asp-action="Devolver" method="post" class="d-inline">
                            <input type="hidden" name="rentalId" value="@a.RentalId" />
                            <button type="submit" class="btn btn-sm btn-primary">Devolver</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
